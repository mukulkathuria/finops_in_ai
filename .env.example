# AI FinOps Gateway configuration. PLACEHOLDERS ONLY - never commit real secrets.
# Quick start: run "uv run python scripts/init_env.py" to write a .env with fresh random secrets.

# ---------------------------------------------------------------- runtime
ENVIRONMENT=dev                       # dev | test | staging | production; unset means production (refuses unsafe defaults)
LOG_LEVEL=INFO
SERVICE_NAME=finops-gateway

# ---------------------------------------------------------------- database (PostgreSQL 19)
# Superuser password for the postgres container only (compose). Applications never use it.
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432                    # host port published by compose
FINOPS_DB=finops
FINOPS_MIGRATOR_PASSWORD=CHANGE_ME
FINOPS_APP_PASSWORD=CHANGE_ME
FINOPS_WORKER_PASSWORD=CHANGE_ME
FINOPS_READONLY_PASSWORD=CHANGE_ME
# Host-run URLs (tests, uv run). docker compose builds its own in-network URLs from the passwords.
DATABASE_URL=postgresql://app:CHANGE_ME@127.0.0.1:5432/finops
WORKER_DATABASE_URL=postgresql://worker:CHANGE_ME@127.0.0.1:5432/finops
MIGRATOR_DATABASE_URL=postgresql://migrator:CHANGE_ME@127.0.0.1:5432/finops
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=5000
# Integration tests: superuser URL used only to create and drop disposable test databases.
TEST_DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/postgres

# ---------------------------------------------------------------- worker: budget janitor (US-10)
JANITOR_INTERVAL_SECONDS=30           # how often holds of requests that died are returned
RECONCILE_INTERVAL_SECONDS=300        # how often budget counters are rebuilt from the ledger
OUTBOX_INTERVAL_SECONDS=5             # how often outbox events (alert webhooks) are delivered

# ---------------------------------------------------------------- worker: price sync (Phase 3)
PRICE_SYNC_SOURCE=config/prices.json  # JSON price list (file or https URL); empty: no sync
PRICE_SYNC_INTERVAL_SECONDS=3600      # how often the catalog is compared with the list

# ---------------------------------------------------------------- worker: response cache (US-18)
CACHE_JANITOR_INTERVAL_SECONDS=300    # how often expired cached answers are deleted
CACHE_MAX_ENTRIES_PER_ORG=50000       # an org over this loses its oldest cached answers first

# ---------------------------------------------------------------- observability (US-29)
# OTLP/HTTP collector base URL, e.g. http://otel-collector:4318; empty = no export
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SAMPLE_RATIO=1.0                 # share of new traces kept; a caller's sampling decision is honoured
# bearer token for /metrics; when empty, /metrics is served in dev and test only
METRICS_TOKEN=

# ---------------------------------------------------------------- edge and dashboard
FORWARDED_ALLOW_IPS=127.0.0.1         # proxies whose X-Forwarded-For uvicorn trusts (per-IP limits)
WEB_PORT=5173                         # host port of the dashboard (compose service web)

# ---------------------------------------------------------------- authentication (US-01, US-03)
JWT_SIGNING_KEY=CHANGE_ME             # base64url 32-byte Ed25519 seed; init_env.py generates one
JWT_KEY_ID=k1
# kid:base64url,... old public keys still accepted while rotating
JWT_PREVIOUS_PUBLIC_KEYS=
JWT_ISSUER=finops-gateway
JWT_AUDIENCE=finops
ACCESS_TOKEN_TTL_SECONDS=900
SIGNUP_MODE=bootstrap                 # bootstrap (first org only) | open (multi-tenant) | disabled
PASSWORD_HASH_CONCURRENCY=4
REFRESH_TOKEN_TTL_SECONDS=1209600     # 14 days, sliding; rotated on every refresh (US-03)
REFRESH_FAMILY_TTL_SECONDS=2592000    # 30 days absolute; then sign in again
LOGIN_MAX_FAILURES=5                  # then lock with exponential backoff (1 min .. 1 h)
AUTH_RATE_LIMIT_PER_MINUTE=30         # per client address on public auth endpoints
RATE_LIMIT_PER_MINUTE=1200            # per API key or user: every authenticated data-plane request
HEAVY_RATE_LIMIT_PER_MINUTE=60        # per API key or user: uploads, document ingests, Markdown conversions
INVITE_TTL_HOURS=72                   # invitation links expire after this many hours (US-02)
WEB_BASE_URL=http://127.0.0.1:5173    # dashboard origin used in invitation links
# This gateway's public origin, for single sign-on: each org's provider calls back to
# <PUBLIC_BASE_URL>/v1/auth/sso/callback. Empty turns single sign-on off; https outside dev.
PUBLIC_BASE_URL=http://127.0.0.1:8080

# ---------------------------------------------------------------- providers and adapters
PROVIDER_ADAPTER_DEFAULT=native       # native | litellm (the optional extra; serves OpenAI-compatible providers)
MASTER_KEY=CHANGE_ME                  # base64url 32 bytes; wraps the data key of every stored provider key
MASTER_KEY_ID=m1
# kid:base64url,... older master keys kept for decryption only
MASTER_PREVIOUS_KEYS=
# Provider API keys: a provider in config/gateway.yaml is offered only when its key is set.
MOCK_LLM_API_KEY=dev-mock-key         # the dev mock accepts any bearer token; not a secret
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MAX_REQUEST_BYTES=10485760            # 10 MiB request body limit (413 above it)

# ---------------------------------------------------------------- files (US-14)
MAX_UPLOAD_BYTES=26214400             # 25 MiB per file (413 above it)
MAX_FILE_PAGES=500                    # PDF pages or presentation slides
MAX_IMAGE_PIXELS=50000000             # width x height
FILE_CHECK_TIMEOUT_S=15               # the isolated PDF check and the ClamAV scan
OBJECT_STORE=local                    # local disk (one host or a shared volume)
OBJECT_STORE_PATH=/var/lib/finops/objects
# clamd host:port (StreamMaxLength >= MAX_UPLOAD_BYTES); empty: off
CLAMAV_ADDRESS=

# ---------------------------------------------------------------- document parsing (US-15, US-16)
OCR_BACKEND=glm_ocr                   # glm_ocr | paddleocr_vl (one at a time; restart to switch)
OCR_MIN_CONFIDENCE=0.80               # a page read below this keeps its original image
GLM_OCR_BASE_URL=http://docparse:8000/v1       # production: the GLM-OCR sidecar
GLM_OCR_MODEL=zai-org/GLM-OCR         # use the name your server reports
PADDLEOCR_VL_BASE_URL=http://docparse:8000/v1  # production: the PaddleOCR-VL sidecar
PADDLEOCR_VL_MODEL=PaddleOCR-VL-1.5-0.9B
PARSER_BASE_URL=http://docparse:8000/v1        # MarkItDown for Office files and HTML
PARSE_TIMEOUT_S=600
DOCPARSE_VLM_BASE_URL=http://mock-llm:8000/v1  # the sidecar's OCR model server (vLLM)

# ---------------------------------------------------------------- retrieval (US-13)
EMBEDDER_BASE_URL=http://mock-llm:8000/v1  # production: your bge-m3 server (TEI, vLLM, Infinity)
EMBEDDER_MODEL=bge-m3                 # 1024-dimensional vectors (the chunks column)
# if the embedding server needs one (the dev mock needs any)
EMBEDDER_API_KEY=
EMBEDDER_TIMEOUT_S=30
RERANKER_BASE_URL=http://mock-llm:8000/v1  # production: your bge-reranker server (/rerank API); empty: none
RERANKER_MODEL=bge-reranker-v2-m3
# if the reranker needs one (the dev mock needs any)
RERANKER_API_KEY=
RERANKER_TIMEOUT_S=10

# --- Image prompt moderation (US-24) ---------------------------------------------------
MODERATION_BACKEND=rules              # rules (built in) | openai_compat (a moderation API)
# openai_compat: e.g. https://api.openai.com/v1
MODERATION_BASE_URL=
# openai_compat: the API's key
MODERATION_API_KEY=
MODERATION_MODEL=omni-moderation-latest
MODERATION_TIMEOUT_S=5               # no verdict in time: the image request is refused
OCR_GPU_SECOND_MICRO_USD=300          # OCR compute per GPU second, subtracted from savings (US-17)
CLASSIFIER_CALL_MICRO_USD=20          # one guardrail classifier call
EMBEDDING_MICRO_USD_PER_MTOK=10000    # embedding a million tokens
MAX_INDEXED_CHUNKS_PER_ORG=1000000    # index quota per organisation (403 index_quota_exceeded above it)

# ---------------------------------------------------------------- classifiers
CLASSIFIER_BACKEND=laya               # rules | laya | jev
# empty means Jev is unavailable
JEV_API_KEY=
JEV_BASE_URL=https://routellm.abacus.ai  # Jev (TypeSafe SystemOne API); used only with a key
JEV_MODEL=jev-latest
LAYA_BASE_URL=http://mock-llm:8000    # dev: the mock's SystemOne stand-in; real Laya: http://laya:8000
# only if laya-serve runs with LAYA_API_KEY
LAYA_API_KEY=
CLASSIFIER_TIMEOUT_MS=2000            # a slower answer counts as a classifier failure
GUARDRAIL_MAX_INPUT_CHARS=2000000     # text the input checks read per request (413 input_too_large above it)
