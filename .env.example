# AI FinOps Gateway configuration. PLACEHOLDERS ONLY - never commit real secrets.
# Quick start: run "uv run python scripts/init_env.py" to write a .env with fresh random secrets.

# ---------------------------------------------------------------- runtime
ENVIRONMENT=dev                       # dev | test | staging | production (production refuses unsafe defaults)
LOG_LEVEL=INFO
SERVICE_NAME=finops-gateway

# ---------------------------------------------------------------- database (PostgreSQL 19)
# Superuser password for the postgres container only (compose). Applications never use it.
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432                    # host port published by compose
FINOPS_DB=finops
FINOPS_MIGRATOR_PASSWORD=CHANGE_ME
FINOPS_APP_PASSWORD=CHANGE_ME
FINOPS_WORKER_PASSWORD=CHANGE_ME
FINOPS_READONLY_PASSWORD=CHANGE_ME
# Host-run URLs (tests, uv run). docker compose builds its own in-network URLs from the passwords.
DATABASE_URL=postgresql://app:CHANGE_ME@127.0.0.1:5432/finops
WORKER_DATABASE_URL=postgresql://worker:CHANGE_ME@127.0.0.1:5432/finops
MIGRATOR_DATABASE_URL=postgresql://migrator:CHANGE_ME@127.0.0.1:5432/finops
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=5000
# Integration tests: superuser URL used only to create and drop disposable test databases.
TEST_DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/postgres

# ---------------------------------------------------------------- authentication (US-01, US-03)
JWT_SIGNING_KEY=CHANGE_ME             # base64url 32-byte Ed25519 seed; init_env.py generates one
JWT_KEY_ID=k1
JWT_PREVIOUS_PUBLIC_KEYS=             # kid:base64url,... old public keys still accepted while rotating
JWT_ISSUER=finops-gateway
JWT_AUDIENCE=finops
ACCESS_TOKEN_TTL_SECONDS=900
SIGNUP_MODE=bootstrap                 # bootstrap (first org only) | open (multi-tenant) | disabled
PASSWORD_HASH_CONCURRENCY=4
INVITE_TTL_HOURS=72                   # invitation links expire after this many hours (US-02)
WEB_BASE_URL=http://127.0.0.1:5173    # dashboard origin used in invitation links

# ---------------------------------------------------------------- providers and adapters
PROVIDER_ADAPTER_DEFAULT=native       # native | litellm (litellm = optional Python adapter)

# ---------------------------------------------------------------- OCR (one backend at a time)
OCR_BACKEND=glm_ocr                   # glm_ocr | paddleocr_vl
OCR_MIN_CONFIDENCE=0.80
GLM_OCR_BASE_URL=http://glm-ocr:8000/v1
GLM_OCR_MODEL=zai-org/GLM-OCR         # use the name your server reports
PADDLEOCR_VL_BASE_URL=http://paddleocr-vl:8080/v1
PADDLEOCR_VL_MODEL=PaddleOCR-VL-1.5-0.9B  # use the name your server reports

# ---------------------------------------------------------------- classifiers
CLASSIFIER_BACKEND=laya               # rules | laya | jev
JEV_API_KEY=                          # empty means Jev is unavailable
